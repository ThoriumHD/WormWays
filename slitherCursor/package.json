{
  "name": "slither-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/client",
    "apps/game-server"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm -C apps/game-server dev\" \"pnpm -C apps/client dev\"",
    "dev:client": "pnpm -C apps/client dev",
    "dev:server": "pnpm -C apps/game-server dev",
    "build": "pnpm -C apps/client build && pnpm -C apps/game-server build",
    "start": "concurrently \"pnpm -C apps/game-server start\" \"pnpm -C apps/client preview\"",
    "format": "echo formatting not configured yet"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
