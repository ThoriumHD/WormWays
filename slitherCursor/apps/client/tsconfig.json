{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@packages/proto": ["../../packages/proto/src"],
      "@slither/common": ["../../packages/common/src"]
    },

    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
